{
  "manifest_version": 3,
  "name": "Multitool Sniffer",
  "version": "1.0",
  "description": "Reports video requests seen in your tabs to the local Multitool server.",
  "permissions": ["webRequest", "tabs", "cookies", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"], "js": ["mark.js"], "run_at": "document_start" }
  ]
}
